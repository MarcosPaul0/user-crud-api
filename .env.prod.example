# =============================================================================
# .env.prod.example — Variáveis de ambiente de produção
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo:  cp .env.prod.example .env
#   2. Preencha TODOS os valores marcados com TODO
#   3. NUNCA commite o arquivo .env no git (está no .gitignore)
#   4. Em produção real, considere Docker Secrets ou um vault (Vault, AWS SM)
#
# Este arquivo é lido pelo docker-compose.prod.yml via env_file: .env
# O DotNetEnv (Env.Load() no Program.cs) também lê .env se presente no container,
# mas as variáveis injetadas pelo docker-compose têm precedência.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL — usado pelo docker-compose para criar o banco e pelo app para conectar
# TODO: Use senhas fortes e únicas (ex: openssl rand -base64 32)
# -----------------------------------------------------------------------------
POSTGRES_USER=usercrud_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=usercrud_production


# -----------------------------------------------------------------------------
# CORS — origens permitidas para requisições cross-origin
# TODO: Substitua pelo domínio real do frontend (sem trailing slash)
# -----------------------------------------------------------------------------
ORIGIN=https://yourdomain.com


# -----------------------------------------------------------------------------
# JWT — autenticação via tokens RSA
# As chaves devem ser encodadas em Base64 (sem quebras de linha)
#
# Como gerar o par de chaves RSA:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
#   # Converter para Base64 sem quebras de linha:
#   base64 -w 0 private.pem  → JWT_PRIVATE_KEY
#   # Para a chave pública, extraia apenas o SubjectPublicKeyInfo (DER format):
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w 0  → JWT_PUBLIC_KEY
#
# TODO: Gere um par de chaves RSA novo para produção
# -----------------------------------------------------------------------------
JWT_ISSUER=your-issuer-name
JWT_AUDIENCE=your-audience-name
JWT_EXPIRATION_TIME_IN_MINUTES=240
JWT_PRIVATE_KEY=base64-encoded-rsa-private-key
JWT_PUBLIC_KEY=base64-encoded-rsa-public-key-subjectpublickeyinfo-der


# -----------------------------------------------------------------------------
# Cookies
# TODO: Substitua pelo nome do cookie que identifica o token JWT
# -----------------------------------------------------------------------------
AUTH_TOKEN_COOKIE=usercrud_token


# -----------------------------------------------------------------------------
# Object Storage — Cloudflare R2 (ou qualquer endpoint S3-compatível)
#
# Para Cloudflare R2:
#   OBJECT_STORAGE_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_PUBLIC_URL: https://pub-<TOKEN>.r2.dev/<bucket> (ou domínio customizado)
#
# TODO: Crie um bucket no Cloudflare R2 e gere as credenciais de API R2
# -----------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=usercrud-bucket
OBJECT_STORAGE_ID=your-cloudflare-account-id
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_PUBLIC_URL=https://pub-your-token.r2.dev/usercrud-bucket
OBJECT_STORAGE_ACCESS_KEY=your-r2-access-key-id
OBJECT_STORAGE_SECRET_KEY=your-r2-secret-access-key


# -----------------------------------------------------------------------------
# Kestrel HTTPS (opcional — descomente se habilitar TLS direto no Kestrel)
# Somente necessário se não usar o nginx para SSL termination
# -----------------------------------------------------------------------------
# KESTREL_CERT_PASSWORD=change-me-pfx-password

# =============================================================================
# Dockerfile.migrator — Aplicação de Migrations EF Core
# =============================================================================
#
# Imagem efêmera baseada no SDK — roda `dotnet ef database update` e sai.
# Usada pelo serviço `migrator` no docker-compose.prod.yml, que o docker-compose
# garante que complete com sucesso antes de subir o serviço `api`.
#
# Não é uma imagem de longa duração: não há EXPOSE, volumes de dados nem restart.
# =============================================================================

FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src

# --- Passo 1: restore (camada cacheada enquanto os .csproj não mudam) ---
COPY AutoriaStore.sln .
COPY src/API/AutoriaStore.API.csproj                      src/API/
COPY src/Application/AutoriaStore.Application.csproj      src/Application/
COPY src/Domain/AutoriaStore.Domain.csproj                src/Domain/
COPY src/Infrastructure/AutoriaStore.Infrastructure.csproj src/Infrastructure/

RUN dotnet restore "AutoriaStore.sln"

# --- Passo 2: código-fonte completo ---
COPY . .

# Compila em Release durante o build da imagem.
# Erros de compilação aparecem aqui com output completo, não suprimidos pelo EF Core.
RUN dotnet build "src/API/AutoriaStore.API.csproj" \
    -c Release \
    --no-restore

# Instala dotnet-ef globalmente para uso no CMD
RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/root/.dotnet/tools"

# Aplica todas as migrations pendentes ao iniciar o container.
# --no-build: reutiliza o output do RUN acima — sem recompilar em runtime.
# --configuration Release: aponta para o bin/Release gerado pelo build acima.
# A connection string é injetada em runtime via env_file (.env) no docker-compose.
CMD ["dotnet", "ef", "database", "update", \
     "--project",         "src/Infrastructure/AutoriaStore.Infrastructure.csproj", \
     "--startup-project", "src/API/AutoriaStore.API.csproj", \
     "--no-build", \
     "--configuration",   "Release"]
